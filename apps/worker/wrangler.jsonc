{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rts-quest-3",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "upload_source_maps": false,
  "assets": {
    "directory": "../client/dist"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "Match" },
      { "name": "LOBBY_DIRECTORY", "class_name": "LobbyDirectory" }
    ]
  },
  // Append-only. Production has already applied v1–v4; only newer tags run on
  // deploy. Fresh local `wrangler dev` replays the whole list, so v2 must create
  // LobbyDirectory or v3's delete fails ("non-existent class").
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Match"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyDirectory"] },
    { "tag": "v3", "deleted_classes": ["LobbyDirectory"] },
    { "tag": "v4", "new_sqlite_classes": ["LobbyDirectory"] }
  ],
  "observability": { "enabled": true }
}
