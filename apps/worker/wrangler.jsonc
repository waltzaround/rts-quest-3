{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voidfront-rts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "upload_source_maps": false,
  "assets": {
    "directory": "../client/dist"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "Match" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Match"] },
    // Production already records v2. Keep this checkpoint so Wrangler does not
    // replay v1 and attempt to create the existing Match namespace again.
    { "tag": "v2" },
    // A LobbyDirectory class was deployed from since-reverted code and no longer
    // exists. Drop its namespace so deploys without the export succeed.
    { "tag": "v3", "deleted_classes": ["LobbyDirectory"] }
  ],
  "observability": { "enabled": true }
}
