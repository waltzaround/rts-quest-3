{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voidfront-rts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "upload_source_maps": false,
  "assets": {
    "directory": "../client/dist"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "Match" },
      { "name": "LOBBY_DIRECTORY", "class_name": "LobbyDirectory" }
    ]
  },
  // This list must mirror the migration history production has already recorded
  // (currently at v3); only tags after that are applied on deploy.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Match"] },
    // Checkpoint from a since-reverted deploy that first added LobbyDirectory.
    { "tag": "v2" },
    // Dropped the orphaned first LobbyDirectory class after the code revert.
    { "tag": "v3", "deleted_classes": ["LobbyDirectory"] },
    // LobbyDirectory re-added for real.
    { "tag": "v4", "new_sqlite_classes": ["LobbyDirectory"] }
  ],
  "observability": { "enabled": true }
}
