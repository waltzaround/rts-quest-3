{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voidfront-rts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "upload_source_maps": false,
  "assets": {
    "directory": "../client/dist"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "Match" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Match"] },
    // Production already records v2. Keep this checkpoint so Wrangler does not
    // replay v1 and attempt to create the existing Match namespace again.
    { "tag": "v2" },
    // v3 originally deleted a leftover LobbyDirectory namespace from reverted
    // production code. Local Wrangler never created that class, so
    // deleted_classes crashes `wrangler dev`. Keep the tag so environments
    // already at v3 stay aligned.
    { "tag": "v3" }
  ],
  "observability": { "enabled": true }
}
